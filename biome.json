{
	"files": {
		"ignore": ["dist/**", "dummy-backend/**", "public/taggedOSIS/**"]
	},
	"$schema": "https://biomejs.dev/schemas/1.7.3/schema.json",
	"organizeImports": {
		"enabled": true
	},
	"linter": {
		"enabled": true,
		"rules": {
			"suspicious": {
				"noExplicitAny": "off"
			},
			"recommended": true
		}
	}
}
